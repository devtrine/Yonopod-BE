# Server
PORT=6767
NODE_ENV=development

# Database
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_HOST=127.0.0.1
DB_PORT=5432

# S3 (Huby)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=true
S3_MULTIPART_TRESSHOLD=64MB
S3_MULTIPART_CHUNKSIZE=64MB

# S3 Webhook & Upload Behavior
BHV_BYPASS_HOOK=false
S3_WEBHOOK_SECRET=your_s3_webhook_bearer_token
